# Copy these into Vercel (Settings > Environment Variables) and GitHub (Settings > Secrets and variables > Actions).
# Never commit real values.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require   # set automatically by Vercel's Neon integration
JH_SECRET_KEY=long-random-string            # Vercel only: signs sign-in cookies
ANTHROPIC_API_KEY=sk-ant-...                # Claude API key (AI email finder)
JH_GMAIL_ADDRESS=pjfreelance02@gmail.com    # Gmail that sends notifications and approved emails
JH_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   # Google app password (not your normal password)
JH_NOTIFY_EMAIL=pjfreelance02@gmail.com     # where notifications go
JH_GITHUB_TOKEN=                            # optional (Vercel): lets "Scan now" start the GitHub Actions scan
